 	<repositories>
    	<repository>
        	<id>scijava.public</id>
        	<url>https://maven.scijava.org/content/groups/public</url>
    	</repository>
    </repositories>
 
	<!-- Optional Dependencies section -->
    <dependencies>
        <!-- ImageJ dependencies -->
        <dependency>
            <groupId>net.imagej</groupId>
            <artifactId>ij</artifactId>
        </dependency>        
        
        <!-- Bio-Formats dependencies -->
		<dependency>
			<groupId>ome</groupId>
			<artifactId>bio-formats_plugins</artifactId>
			<exclusions>
				<!-- Fiji supplies guava; excluded to keep it off this build's classpath. -->
				<exclusion>
					<groupId>com.google.guava</groupId>
					<artifactId>guava</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		
		<dependency>
			<groupId>ome</groupId>
			<artifactId>formats-api</artifactId>
		</dependency>
		
      	<!-- From v0.2.1 on: commons-lang3 - used by the vendored Steger detector
        	(ciliaQ_Prep_jnh.ij_ridge_detector_steger: MutableInt / MutableDouble / MutableLong) -->
		<dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
    </dependencies>  
    
    <build>
	    <plugins>
	        <!-- avoid errors in java doc creation -->
	        <plugin>
	            <groupId>org.apache.maven.plugins</groupId>
	            <artifactId>maven-javadoc-plugin</artifactId>
	            <configuration>
	                <doclint>none</doclint>
	            </configuration>
	        </plugin>
	
	        <plugin>
	            <artifactId>maven-jar-plugin</artifactId>
	            <configuration>
	                <archive>
	                    <manifest>
	                        <mainClass>${main-class}</mainClass>
	                    </manifest>
	                </archive>
	            </configuration>
	        </plugin>
	        
	        <!-- Disable the SciJava parent's inherited populate-app: it copies the WHOLE dependency
	             tree into Fiji (and upgrades shared libs like slf4j), which prevents testing the
	             plugin as a bare single-jar install. We copy only our own jar via antrun below. -->
	        <plugin>
	            <groupId>org.scijava</groupId>
	            <artifactId>scijava-maven-plugin</artifactId>
	            <executions>
	                <execution>
	                    <id>populate-app</id>
	                    <phase>none</phase>
	                </execution>
	            </executions>
	        </plugin>
	        
	        <!-- copy to local FIJI upon building -->
	        <plugin>
			    <groupId>org.apache.maven.plugins</groupId>
			    <artifactId>maven-antrun-plugin</artifactId>
			    <executions>
			        <execution>
			            <id>copy-jar-to-fiji</id>
			            <phase>package</phase>
			            <goals><goal>run</goal></goals>
			            <configuration>
			                <target>
			                    <!-- delete first: Windows allows deleting a loaded jar (handle stays open),
			                         then we write a fresh file - this avoids the overwrite-in-use lock -->
			                    <delete>
			                        <fileset dir="${scijava.app.directory}/plugins"
			                                 includes="${project.artifactId}-*.jar"/>
			                    </delete>
			                    <copy file="${project.build.directory}/${project.artifactId}-${project.version}.jar"
			                          todir="${scijava.app.directory}/plugins"/>
			                </target>
			            </configuration>
			        </execution>
			    </executions>
			</plugin>
	    </plugins>
	</build>
</project>